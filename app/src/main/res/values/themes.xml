<resources>
    <!-- Shown only while the app process starts. -->
    <style name="Theme.Kash.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kash</item>
    </style>

    <style name="Theme.Kash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kash_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
